{
  "description": "application exits with code 2 and the kubelet restarts it (CrashLoopBackOff)",
  "target": {"selector": "app=exit2", "container": "app"},
  "expect": {
    "container": "app",
    "verdictKind": "app-exit",
    "confidence": "confirmed",
    "evidenceKinds": ["pod-status"],
    "expectedness": "unexpected",
    "contains": ["exitCode=2"],
    "forbidKinds": ["exit-signal-convention", "oom-kill-reported"]
  }
}
