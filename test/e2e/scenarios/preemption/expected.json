{
  "description": "a high-priority pod does not fit; the scheduler preempts the low-priority pod (DisruptionTarget PreemptionByScheduler)",
  "timeoutSeconds": 200,
  "steps": [
    {"wait": ["--for=condition=Ready", "pod/low", "--timeout=120s"]},
    {"apply": "high.yaml"}
  ],
  "cleanup": [
    {"kubectl": ["delete", "priorityclass", "wd-e2e-low", "wd-e2e-high", "--ignore-not-found"], "noNamespace": true, "allowFail": true}
  ],
  "target": {"name": "low"},
  "expect": {
    "verdictKind": "preemption-scheduler",
    "confidence": "confirmed",
    "evidenceKinds": ["pod-condition"],
    "forbidKinds": ["eviction-node-pressure", "controller-delete"]
  }
}
